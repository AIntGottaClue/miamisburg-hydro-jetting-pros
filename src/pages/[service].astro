---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Callout from '../components/Callout.astro';
import { u } from '../lib/utils';
import { business, SITE_URL } from '../lib/site';
import { faqSchema } from '../lib/seo';
export function getStaticPaths() {
const sewer = 'https://cityofmiamisburg.com/water-sewer/';
const ordinance = 'https://cityofmiamisburg.com/documents/sewer-ordinance/';
const epa = 'https://nepis.epa.gov/Exe/ZyPURL.cgi?Dockey=P10053G5.TXT';
const storm = 'https://codelibrary.amlegal.com/codes/miamisburg/latest/miamisburg_oh/0-0-0-13916';
const services = [
{slug:'severe-grease-and-sludge',name:'Severe Grease and Sludge',intro:'Kitchen wastewater can leave grease and soft deposits along a drain wall. In Miamisburg, first identify the affected private line and its sewer connection before choosing a cleaning method.', heading:'Clear buildup, then change what reaches the drain.', text:'Water jetting can scour grease and move loose debris through a suitable line. It is not a replacement for grease-trap care or keeping fats and oils out of the sink. Tell us whether the backup starts at one kitchen fixture or affects several drains, and whether a grease interceptor sits upstream.',local:'Miamisburg provides water and sewer service to its residents and publishes a <a href="https://cityofmiamisburg.com/documents/sewer-ordinance/" target="_blank" rel="noopener noreferrer">sewer ordinance</a>. Before treating a backup as private kitchen-line buildup, ask the city public works office whether the problem could sit at the public connection.',image:'power-spray-1.jpg',alt:'Illustration of a water jet spraying inside a pipe',faqs:[{title:'Does hot water permanently remove grease?',text:'No. Do not rely on hot water to keep grease out of sewer lines. EPA guidance recommends collecting grease and oil for disposal rather than putting it into drains.'},{title:'Will jetting maintain a grease interceptor?',text:'Pipe cleaning and interceptor maintenance are different tasks. The interceptor needs its own inspection and cleaning plan; jetting a downstream line does not empty it.'},{title:'Can every grease-clogged pipe be jetted?',text:'No. Access, pipe condition and the obstruction must be assessed. A broken or unsuitable line may need a different approach.'}],sources:[sewer,epa]},
{slug:'tree-root-intrusions',name:'Tree Root Intrusions',intro:'Recurring sewer backups may involve roots, but nearby trees alone do not prove a root blockage. For a Miamisburg property, inspect the line and locate the affected section before discussing root removal.',heading:'Root clearing is not pipe repair.',text:'Jetting equipment can address some roots inside suitable pipes. Roots at a damaged joint can return, and cleaning does not seal an opening, realign a joint or replace a collapsed pipe. A camera view can help distinguish material that can be cleared from a defect that needs repair.',local:'Miamisburg publishes a sewer ordinance covering sanitary sewer connections. If clearing exposes a repair need, ask the city which rules apply to that work before treating excavation as part of routine cleaning.',image:'root-macro-action-37.jpg',alt:'Illustration of roots inside a sewer pipe being cleaned with water jets',faqs:[{title:'Does root removal stop roots forever?',text:'No. If an entry point remains, roots can return. Discuss the condition of the pipe and whether repair is needed after the obstruction is assessed.'},{title:'Should I remove a tree before inspecting the drain?',text:'Do not assume a particular tree caused the blockage. Locate the obstruction and pipe defect first; drain assessment does not establish which tree is responsible.'},{title:'Does a cleared line still need repair?',text:'It may. Better flow does not prove joints and pipe walls are sound. Inspection findings should guide that decision.'}],sources:[ordinance,epa]},
{slug:'recurring-clogs-and-slow-drains',name:'Recurring Clogs and Slow Drains',intro:'A Miamisburg drain that slows again after clearing needs a closer look at the pattern. One affected fixture, several fixtures, and backups during wet weather point to different questions.',heading:'Record the pattern before choosing the tool.',text:'Describe which fixtures back up, how quickly the trouble returns and what earlier cleaning achieved. Water jetting may help when deposits remain along a suitable line, but repeat symptoms can also involve a damaged pipe or a problem beyond the private drain.',local:'Miamisburg publishes storm water rules separately from its sewer service. If symptoms appear during rain, report the timing and ask the city to assess the public system. Do not assume jetting a private line can correct storm-water inflow or a public sewer issue.',image:'recurring-clogs-clean-sweep-41.jpg',alt:'Illustration of a jetting nozzle inside a drain pipe',faqs:[{title:'Does a recurring clog always mean the drain needs jetting?',text:'No. A repeat blockage calls for diagnosis. Jetting is one cleaning option, not a fix for every pipe or utility problem.'},{title:'What if several drains back up at once?',text:'Stop using affected fixtures and describe the shared symptoms. A downstream blockage or public-system issue may need assessment; avoid assuming the problem is only at one sink.'},{title:'What should I put in the request?',text:'Give the affected fixture, recurrence, rain timing and prior cleaning history. Mention whether the property connects to sanitary sewer or onsite treatment, if known.'}],sources:[sewer,storm,epa]},
{slug:'mineral-and-scale-deposits',name:'Mineral and Scale Deposits',intro:'Hard deposits in a Miamisburg drain should be identified before a cleaning plan is chosen. Pipe-wall buildup, corrosion and a damaged joint can look similar without a clear inspection.',heading:'Identify the deposit and the pipe beneath it.',text:'A camera assessment and known pipe material help determine whether water jetting is suitable or whether another treatment is needed. Do not infer drain scale from a water-quality reading alone. Cleaning must account for weakened walls and the remaining condition of the line.',local:'A city sewer ordinance sets rules for connections, but it does not show what is installed at an existing property. Check the actual line, available records and access points instead of assuming every Miamisburg drain has the same material.',image:'pipe-blueprint-4.jpg',alt:'Illustration showing water jets along the interior wall of a pipe',faqs:[{title:'Can jetting remove every hard deposit?',text:'No. Suitability depends on the deposit, pipe condition and equipment. An assessment should establish what can safely be cleaned.'},{title:'Does the age of a house identify its sewer pipe?',text:'No. Repairs and replacements may have changed the line. Records and inspection are more useful than a guess based on house age.'},{title:'Is drain jetting a water-softening service?',text:'No. Drain cleaning addresses a wastewater pipe. It does not treat the household water supply or change water hardness.'}],sources:[ordinance,epa]},
{slug:'preventative-maintenance',name:'Preventative Maintenance',intro:'A useful Miamisburg drain-maintenance plan starts with the property, line condition and blockage history, not a fixed cleaning schedule applied to every home or business.',heading:'Choose a schedule from evidence.',text:'Record recurring trouble, kitchen use, grease-control practices and prior inspections. Routine jetting may suit some lines, while others need monitoring or repair instead. Keep a record of findings so the next visit is based on what changed rather than repeating the same treatment without a reason.',local:'A maintenance plan depends on the line, the building and its blockage history. The Miamisburg public works office handles city water and sewer questions; a private-line cleaning plan is a separate decision.',image:'recurring-clogs-clean-sweep-41.jpg',alt:'Illustration of a clean pipe interior with a jetting hose',faqs:[{title:'How often should a drain be hydro jetted?',text:'There is no single interval for every property. Use condition, usage and documented recurrence to decide whether and when cleaning is appropriate.'},{title:'Does preventative jetting replace a camera inspection?',text:'No. Cleaning removes buildup; a camera inspection shows pipe condition. They answer different questions and can be discussed together.'},{title:'What can I do between cleaning visits?',text:'Keep grease, wipes and other inappropriate waste out of the drain, follow applicable interceptor care requirements and record any new slowdowns or backups.'}],sources:[sewer,epa]},
{slug:'how-hydro-jetting-works',name:'How Hydro Jetting Works',intro:'Hydro jetting uses a hose and nozzle to direct water inside a drain. At a Miamisburg property, the first step is understanding the pipe and wastewater connection, not choosing pressure from a headline.',heading:'Assess, access, clean and check.',text:'The line condition and accessible entry point are reviewed before equipment is selected. Water jets loosen suitable deposits and move debris through the pipe. Inspection may be needed before and after cleaning to understand restrictions and distinguish remaining damage from removable material.',local:'The <a href="https://cityofmiamisburg.com/water-sewer/" target="_blank" rel="noopener noreferrer">city water and sewer page</a> lists who to call for public-system questions. A contractor needs to know where the line goes and which section is being discussed, and rule questions for connections and alterations belong with the city.',image:'power-spray-1.jpg',alt:'Illustration of a hydro jetting nozzle spraying water',faqs:[{title:'Is more pressure always better?',text:'No. Pipe condition, material, diameter, access and the obstruction determine an appropriate approach. A pressure number alone does not establish suitability.'},{title:'Can jetting repair a collapsed drain?',text:'No. Cleaning removes suitable material; it does not rebuild a collapsed pipe or correct a structural defect.'},{title:'Does submitting the form schedule the work?',text:'No. It requests contact about your line and symptoms. The next step must be discussed for the specific property.'}],sources:[sewer,ordinance,epa]},
{slug:'hydro-jetting-vs-snaking',name:'Hydro Jetting vs Snaking',intro:'For a Miamisburg drain, choosing between a mechanical cable and water jetting depends on the obstruction and pipe condition. Neither method is automatically right for every slow drain.',heading:'Opening a blockage and cleaning a wall are different goals.',text:'<a href="https://nepis.epa.gov/Exe/ZyPURL.cgi?Dockey=P10053G5.TXT" target="_blank" rel="noopener noreferrer">Mechanical rodding</a> uses a rotating tool to break up or cut material. Jetting uses directed water to scour suitable buildup and move debris. A local opening may restore flow without addressing deposits farther along a line, while jetting may be unsuitable for a weakened pipe. Assessment should guide the choice.',local:'Confirm whether the concern is inside a private Miamisburg drain or at a public sewer connection. The city water and sewer page lists who to call; neither a cable nor a jet can correct every public-system problem.',image:'pipe-blueprint-4.jpg',alt:'Illustration of a nozzle cleaning the interior of a drain pipe',faqs:[{title:'Is hydro jetting always better than snaking?',text:'No. Different tools fit different line conditions and obstructions. Choose from the assessment, not a blanket ranking.'},{title:'What if a cable cleared the drain but trouble returned?',text:'Describe how long flow improved and which symptoms came back. Inspection can help identify remaining buildup or a structural concern before another cleaning method is chosen.'},{title:'Can either method repair a broken joint?',text:'No. Clearing material and repairing the pipe are separate tasks. A damaged joint may require repair after the blockage is assessed.'}],sources:[sewer,epa]}
];
return services.map(page=>({params:{service:page.slug},props:{page}})); }
const {page}=Astro.props;
const path=`/${page.slug}`;
const description=`${page.name} in Miamisburg, Ohio: line assessment, local wastewater context and practical answers.`;
const srcSentence = (items: [string, string][], cls = '') => {
  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
  const links = items.map(([url, label]) => `<a href="${esc(url)}" target="_blank" rel="noopener noreferrer"${cls ? ` class="${cls}"` : ' style="text-decoration:underline"'}>${esc(label.replace(/\s*\([^)]*\)\s*$/, '').replace(/:\s+/, ' '))}</a>`);
  const list = links.length === 1 ? links[0] : `${links.slice(0, -1).join(', ')} and ${links[links.length - 1]}`;
  return `The background on this page comes from ${list}.`;
};
---
<Base title={`${page.name} | Miamisburg Hydro Jetting Pros`} description={description} path={path} crumbs={[{name:'Services',path:'/services'},{name:page.name,path}]} extraSchema={[faqSchema(page.faqs),{'@context':'https://schema.org','@type':'Service',name:page.name,serviceType:page.name,areaServed:{'@type':'City',name:'Miamisburg, Ohio'},provider:{'@id':`${SITE_URL}/#business`}}]}>
 <Hero headline={`${page.name} in Miamisburg, OH`} intro={page.intro} location={page.name}/>
 <section class="content-section"><div class="content-inner"><h2 class="section-title">{page.heading}</h2><p class="section-intro"><Fragment set:html={page.text} /></p><h2 class="section-title" style="margin-top:36px">Miamisburg line and utility context</h2><p class="section-intro"><Fragment set:html={page.local} /></p><img src={u(`/images/library/${page.image}`)} alt={page.alt} width="1200" height="896" loading="lazy" style="display:block;width:100%;max-width:720px;height:320px;object-fit:cover;margin:30px 0;border-radius:4px"/><h2 class="section-title">Questions about {page.name.toLowerCase()}</h2>{page.faqs.map(f=><div style="margin:24px 0"><h3>{f.title}</h3><p class="section-intro">{f.text}</p></div>)}<a class="text-link" href={u('/services')}>All services and guides</a></div></section><Callout/>
</Base>
