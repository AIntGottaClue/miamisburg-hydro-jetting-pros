---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import NeighborhoodBody from '../../components/NeighborhoodBody.astro';
import neighborhoods from '../../data/neighborhoodContent.json';
import { business } from '../../lib/site';

export function getStaticPaths() { return neighborhoods.map(n => ({params:{slug:n.slug},props:{n}})); }
const { n } = Astro.props;
const path = `/neighborhood/${n.slug}/`;
const crumbs = [{name:'Neighborhoods',path:'/neighborhood/'},{name:n.name,path}];
const heroCrumbs = crumbs.map(c => ({href:c.path,label:c.name}));
const services = [{"path": "/severe-grease-and-sludge/", "name": "Grease and Sludge", "note": "Discuss buildup from kitchen use"}, {"path": "/tree-root-intrusions/", "name": "Tree Root Intrusions", "note": "Ask what an inspection shows about roots"}, {"path": "/recurring-clogs-and-slow-drains/", "name": "Recurring Clogs and Slow Drains", "note": "Explain how often the blockage returns"}, {"path": "/mineral-and-scale-deposits/", "name": "Mineral and Scale Deposits", "note": "Assess deposits that narrow the line"}, {"path": "/preventative-maintenance/", "name": "Preventative Maintenance", "note": "Plan upkeep around known findings"}];
const schema = ({'@context':'https://schema.org','@type':'FAQPage',mainEntity:n.faqs.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))});
---
<Base title={n.title} description={n.description} path={path} crumbs={crumbs} service={true} extraSchema={[schema]}>
<Hero headline={n.h1} intro={n.hero} location={n.name} crumbs={heroCrumbs} />
<NeighborhoodBody n={n} all={neighborhoods} city="Miamisburg" services={services} phoneHref={business.phoneHref} phoneDisplay={business.phoneDisplay} />
</Base>
